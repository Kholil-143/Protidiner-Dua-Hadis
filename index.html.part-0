          bn: "সকল কাজ নিয়তের উপর নির্ভরশীল, আর প্রত্যেক ব্যক্তি তাই পাবে, যার নিয়ত সে করেছে।",
          narrator: "উমর ইবনুল খাত্তাব (রা.)", src: "সহিহ বুখারি: ১, সহিহ মুসলিম: ১৯০৭", kw: "নিয়ত ইখলাস আমল" },
        { ar: "خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ",
          bn: "তোমাদের মধ্যে সর্বোত্তম সেই ব্যক্তি, যে কুরআন শেখে এবং শেখায়।",
          narrator: "উসমান ইবনে আফফান (রা.)", src: "সহিহ বুখারি: ৫০২৭", kw: "কুরআন ইলম শিক্ষা" },
        { ar: "الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ",
          bn: "প্রকৃত মুসলিম সে-ই, যার জিহ্বা ও হাত থেকে অন্য মুসলিমরা নিরাপদ থাকে।",
          narrator: "আবদুল্লাহ ইবনে আমর (রা.)", src: "সহিহ বুখারি: ১০, সহিহ মুসলিম: ৪০", kw: "আখলাক ব্যবহার জিহ্বা" },
        { ar: "الطُّهُورُ شَطْرُ الْإِيمَانِ، وَالْحَمْدُ لِلَّهِ تَمْلَأُ الْمِيزَانَ",
          bn: "পবিত্রতা ঈমানের অর্ধেক, আর ‘আলহামদুলিল্লাহ’ (বললে তা সওয়াবে) পাল্লা পূর্ণ করে দেয়।",
          narrator: "আবু মালিক আল-আশআরি (রা.)", src: "সহিহ মুসলিম: ২২৩", kw: "পবিত্রতা ঈমান যিকির" },
        { ar: "لَا يُؤْمِنُ أَحَدُكُمْ حَتَّىٰ يُحِبَّ لِأَخِيهِ مَا يُحِبُّ لِنَفْسِهِ",
          bn: "তোমাদের কেউ পূর্ণ মুমিন হতে পারবে না, যতক্ষণ না সে নিজের জন্য যা পছন্দ করে, তার ভাইয়ের জন্যও তা-ই পছন্দ করে।",
          narrator: "আনাস ইবনে মালিক (রা.)", src: "সহিহ বুখারি: ১৩, সহিহ মুসলিম: ৪৫", kw: "ঈমান ভালোবাসা ভাই" },
        { ar: "أَحَبُّ الأَعْمَالِ إِلَى اللَّهِ أَدْوَمُهَا وَإِنْ قَلَّ",
          bn: "আল্লাহর কাছে সবচেয়ে প্রিয় আমল হলো যা নিয়মিত করা হয়, যদিও তা অল্প হয়।",
          narrator: "আয়িশা (রা.)", src: "সহিহ বুখারি: ৬৪৬৪, সহিহ মুসলিম: ৭৮৩", kw: "আমল নিয়মিত ধারাবাহিক" },
        { ar: "لَيْسَ الشَّدِيدُ بِالصُّرَعَةِ، إِنَّمَا الشَّدِيدُ الَّذِي يَمْلِكُ نَفْسَهُ عِنْدَ الْغَضَبِ",
          bn: "কুস্তিতে জয়ী ব্যক্তি শক্তিশালী নয়; প্রকৃত শক্তিশালী সে-ই, যে রাগের সময় নিজেকে নিয়ন্ত্রণে রাখতে পারে।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ বুখারি: ৬১১৪, সহিহ মুসলিম: ২৬০৯", kw: "রাগ ধৈর্য শক্তি নিয়ন্ত্রণ" },
        { ar: "الدُّنْيَا سِجْنُ الْمُؤْمِنِ وَجَنَّةُ الْكَافِرِ",
          bn: "দুনিয়া মুমিনের জন্য কারাগারস্বরূপ এবং কাফিরের জন্য জান্নাতস্বরূপ।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ মুসলিম: ২৯৫৬", kw: "দুনিয়া আখিরাত মুমিন" },
        { ar: "مَا نَقَصَتْ صَدَقَةٌ مِنْ مَالٍ",
          bn: "সদকা করলে সম্পদ কমে না।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ মুসলিম: ২৫৮৮", kw: "সদকা দান সম্পদ" },
        { ar: "عَلَيْكُمْ بِالصِّدْقِ، فَإِنَّ الصِّدْقَ يَهْدِي إِلَى الْبِرِّ، وَإِنَّ الْبِرَّ يَهْدِي إِلَى الْجَنَّةِ",
          bn: "তোমরা সত্যবাদিতা অবলম্বন করো। কারণ সত্যবাদিতা সৎকর্মের দিকে পথ দেখায়, আর সৎকর্ম জান্নাতের দিকে পথ দেখায়।",
          narrator: "আবদুল্লাহ ইবনে মাসউদ (রা.)", src: "সহিহ মুসলিম: ২৬০৭", kw: "সত্য সত্যবাদিতা জান্নাত" },
        { ar: "مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ، حَتَّىٰ ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ",
          bn: "জিবরাইল (আ.) আমাকে প্রতিবেশীর হক সম্পর্কে বারবার উপদেশ দিতে থাকলেন, এমনকি আমার মনে হলো — তিনি প্রতিবেশীকে উত্তরাধিকারী বানিয়ে দেবেন।",
          narrator: "আবদুল্লাহ ইবনে উমর (রা.)", src: "সহিহ বুখারি: ৬০১৪, সহিহ মুসলিম: ২৬২৪", kw: "প্রতিবেশী হক জিবরাইল" },
        { ar: "عَجَبًا لِأَمْرِ الْمُؤْمِنِ، إِنَّ أَمْرَهُ كُلَّهُ خَيْرٌ",
          bn: "মুমিনের অবস্থা সত্যিই বিস্ময়কর! তার প্রতিটি অবস্থাই তার জন্য কল্যাণকর — সুখ পেলে সে কৃতজ্ঞ হয়, আর দুঃখে পড়লে সে ধৈর্য ধরে।",
          narrator: "সুহাইব (রা.)", src: "সহিহ মুসলিম: ২৯৯৯", kw: "মুমিন ধৈর্য কৃতজ্ঞতা শুকরিয়া" },
        { ar: "طَلَبُ الْعِلْمِ فَرِيضَةٌ عَلَىٰ كُلِّ مُسْلِمٍ",
          bn: "ইলম (ধর্মীয় জ্ঞান) অর্জন করা প্রত্যেক মুসলিমের উপর ফরজ।",
          narrator: "আনাস ইবনে মালিক (রা.)", src: "সুনানে ইবনে মাজাহ: ২২৪", kw: "ইলম জ্ঞান ফরজ শিক্ষা" },
        { ar: "أَفْشُوا السَّلَامَ بَيْنَكُمْ",
          bn: "তোমরা নিজেদের মধ্যে সালামের ব্যাপক প্রসার ঘটাও — এতে পরস্পরের মধ্যে ভালোবাসা সৃষ্টি হবে।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ মুসলিম: ৫৪", kw: "সালাম ভালোবাসা" },
        { ar: "مَنْ غَدَا إِلَى الْمَسْجِدِ أَوْ رَاحَ، أَعَدَّ اللَّهُ لَهُ فِي الْجَنَّةِ نُزُلًا",
          bn: "যে ব্যক্তি সকালে বা সন্ধ্যায় মসজিদের দিকে যায়, আল্লাহ তার জন্য জান্নাতে আতিথেয়তার ব্যবস্থা প্রস্তুত করে রাখেন।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ বুখারি: ৬৬২, সহিহ মুসলিম: ৬৬৯", kw: "মসজিদ নামাজ জান্নাত" },
        { ar: "إِنَّ اللَّهَ رَفِيقٌ يُحِبُّ الرِّفْقَ فِي الْأَمْرِ كُلِّهِ",
          bn: "নিশ্চয় আল্লাহ অত্যন্ত কোমল; তিনি প্রতিটি কাজে কোমলতা পছন্দ করেন।",
          narrator: "আয়িশা (রা.)", src: "সহিহ বুখারি: ৬৯২৭, সহিহ মুসলিম: ২১৬৫", kw: "কোমলতা নম্রতা আচরণ" },
        { ar: "الرَّاحِمُونَ يَرْحَمُهُمُ الرَّحْمَنُ، ارْحَمُوا مَنْ فِي الْأَرْضِ يَرْحَمْكُمْ مَنْ فِي السَّمَاءِ",
          bn: "দয়ালুদের প্রতি পরম দয়ালু আল্লাহ দয়া করেন। তোমরা জমিনে যারা আছে তাদের প্রতি দয়া করো, আসমানে যিনি আছেন তিনি তোমাদের প্রতি দয়া করবেন।",
          narrator: "আবদুল্লাহ ইবনে আমর (রা.)", src: "সুনানে আবু দাউদ: ৪৯৪১, তিরমিজি: ১৯২৪", kw: "দয়া রহমত করুণা" },
        { ar: "خَيْرُكُمْ خَيْرُكُمْ لِأَهْلِهِ، وَأَنَا خَيْرُكُمْ لِأَهْلِي",
          bn: "তোমাদের মধ্যে সর্বোত্তম সে, যে তার পরিবারের কাছে সর্বোত্তম; আর আমি আমার পরিবারের কাছে তোমাদের মধ্যে সর্বোত্তম।",
          narrator: "আবদুল্লাহ ইবনে আব্বাস (রা.)", src: "সুনানে তিরমিজি: ৩৮৯৫", kw: "পরিবার স্ত্রী আচরণ" },
        { ar: "مَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ فَلْيَقُلْ خَيْرًا أَوْ لِيَصْمُتْ",
          bn: "যে ব্যক্তি আল্লাহ ও শেষ দিনের প্রতি ঈমান রাখে, সে যেন ভালো কথা বলে অথবা চুপ থাকে।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ বুখারি: ৬০১৮, সহিহ মুসলিম: ৪৭", kw: "কথা চুপ জিহ্বা ঈমান" },
        { ar: "إِيَّاكُمْ وَالظَّنَّ، فَإِنَّ الظَّنَّ أَكْذَبُ الْحَدِيثِ",
          bn: "তোমরা (খারাপ) ধারণা থেকে বেঁচে থাকো। কারণ ধারণা হলো সবচেয়ে বড় মিথ্যা কথা।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ বুখারি: ৬০৬৪, সহিহ মুসলিম: ২৫৬৩", kw: "ধারণা সন্দেহ মিথ্যা" },
        { ar: "لَا تَحَاسَدُوا، وَلَا تَبَاغَضُوا، وَلَا تَدَابَرُوا، وَكُونُوا عِبَادَ اللَّهِ إِخْوَانًا",
          bn: "তোমরা পরস্পর হিংসা করো না, বিদ্বেষ পোষণ করো না, সম্পর্ক ছিন্ন করো না; বরং হে আল্লাহর বান্দারা, পরস্পর ভাই ভাই হয়ে যাও।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ মুসলিম: ২৫৫৯", kw: "হিংসা বিদ্বেষ ভ্রাতৃত্ব" },
        { ar: "كَلِمَتَانِ خَفِيفَتَانِ عَلَى اللِّسَانِ، ثَقِيلَتَانِ فِي الْمِيزَانِ، حَبِيبَتَانِ إِلَى الرَّحْمَنِ: سُبْحَانَ اللَّهِ وَبِحَمْدِهِ، سُبْحَانَ اللَّهِ الْعَظِيمِ",
          bn: "দুটি বাক্য জিহ্বায় উচ্চারণে হালকা, পাল্লায় ভারী এবং পরম দয়ালুর কাছে অত্যন্ত প্রিয়: ‘সুবহানাল্লাহি ওয়া বিহামদিহি, সুবহানাল্লাহিল আজিম’।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ বুখারি: ৬৬৮২, সহিহ মুসলিম: ২৬৯৪", kw: "যিকির সুবহানাল্লাহ পাল্লা" },
        { ar: "أَقْرَبُ مَا يَكُونُ الْعَبْدُ مِنْ رَبِّهِ وَهُوَ سَاجِدٌ، فَأَكْثِرُوا الدُّعَاءَ",
          bn: "বান্দা তার প্রতিপালকের সবচেয়ে নিকটবর্তী হয় সিজদারত অবস্থায়; সুতরাং তোমরা (সিজদায়) বেশি বেশি দোয়া করো।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ মুসলিম: ৪৮২", kw: "সিজদা নামাজ দোয়া নৈকট্য" },
        { ar: "مَنْ صَلَّى الْبَرْدَيْنِ دَخَلَ الْجَنَّةَ",
          bn: "যে ব্যক্তি দুই ঠান্ডার নামাজ (ফজর ও আসর) আদায় করবে, সে জান্নাতে প্রবেশ করবে।",
          narrator: "আবু মুসা আল-আশআরি (রা.)", src: "সহিহ বুখারি: ৫৭৪, সহিহ মুসলিম: ৬৩৫", kw: "ফজর আসর নামাজ জান্নাত" },
        { ar: "الصَّلَوَاتُ الْخَمْسُ، وَالْجُمُعَةُ إِلَى الْجُمُعَةِ، كَفَّارَةٌ لِمَا بَيْنَهُنَّ",
          bn: "পাঁচ ওয়াক্ত নামাজ এবং এক জুমা থেকে পরবর্তী জুমা — এগুলোর মধ্যবর্তী (ছোট) গুনাহসমূহের কাফফারা হয়ে যায়।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ মুসলিম: ২৩৩", kw: "নামাজ জুমা গুনাহ কাফফারা" },
        { ar: "مَنْ بَنَىٰ مَسْجِدًا لِلَّهِ، بَنَى اللَّهُ لَهُ فِي الْجَنَّةِ مِثْلَهُ",
          bn: "যে ব্যক্তি আল্লাহর (সন্তুষ্টির) জন্য একটি মসজিদ নির্মাণ করবে, আল্লাহ তার জন্য জান্নাতে অনুরূপ একটি ঘর নির্মাণ করবেন।",
          narrator: "উসমান ইবনে আফফান (রা.)", src: "সহিহ বুখারি: ৪৫০, সহিহ মুসলিম: ৫৩৩", kw: "মসজিদ নির্মাণ জান্নাত সদকা" },
        { ar: "تَبَسُّمُكَ فِي وَجْهِ أَخِيكَ لَكَ صَدَقَةٌ",
          bn: "তোমার ভাইয়ের মুখের দিকে তাকিয়ে তোমার মুচকি হাসিও তোমার জন্য একটি সদকা।",
          narrator: "আবু যর (রা.)", src: "সুনানে তিরমিজি: ১৯৫৬", kw: "হাসি সদকা ভাই আচরণ" },
        { ar: "الْكَلِمَةُ الطَّيِّبَةُ صَدَقَةٌ",
          bn: "ভালো ও উত্তম কথাও একটি সদকা।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ বুখারি: ২৯৮৯, সহিহ মুসলিম: ১০০৯", kw: "কথা সদকা ভালো" },
        { ar: "مَنْ قَرَأَ حَرْفًا مِنْ كِتَابِ اللَّهِ فَلَهُ بِهِ حَسَنَةٌ، وَالْحَسَنَةُ بِعَشْرِ أَمْثَالِهَا",
          bn: "যে ব্যক্তি আল্লাহর কিতাব থেকে একটি হরফ পাঠ করবে, তার জন্য একটি নেকি রয়েছে; আর একটি নেকি তার দশগুণ পর্যন্ত (বৃদ্ধি করা হয়)।",
          narrator: "আবদুল্লাহ ইবনে মাসউদ (রা.)", src: "সুনানে তিরমিজি: ২৯১০", kw: "কুরআন তিলাওয়াত নেকি হরফ" },
        { ar: "الْمَاهِرُ بِالْقُرْآنِ مَعَ السَّفَرَةِ الْكِرَامِ الْبَرَرَةِ",
          bn: "কুরআন পাঠে পারদর্শী ব্যক্তি সম্মানিত, অনুগত ফেরেশতাদের সাথে থাকবে। আর যে কষ্ট করে থেমে থেমে পড়ে, তার জন্য দ্বিগুণ সওয়াব।",
          narrator: "আয়িশা (রা.)", src: "সহিহ বুখারি: ৪৯৩৭, সহিহ মুসলিম: ৭৯৮", kw: "কুরআন তিলাওয়াত ফেরেশতা সওয়াব" },
        { ar: "مَنْ سَلَكَ طَرِيقًا يَلْتَمِسُ فِيهِ عِلْمًا، سَهَّلَ اللَّهُ لَهُ بِهِ طَرِيقًا إِلَى الْجَنَّةِ",
          bn: "যে ব্যক্তি ইলম অন্বেষণে কোনো পথ অবলম্বন করে, আল্লাহ তার জন্য জান্নাতের পথ সহজ করে দেন।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ মুসলিম: ২৬৯৯", kw: "ইলম জ্ঞান জান্নাত পথ" },
        { ar: "الدُّعَاءُ هُوَ الْعِبَادَةُ",
          bn: "দোয়াই হলো ইবাদত।",
          narrator: "নুমান ইবনে বাশির (রা.)", src: "সুনানে আবু দাউদ: ১৪৭৯, তিরমিজি: ২৯৬৯", kw: "দোয়া ইবাদত" },
        { ar: "إِنَّ أَحَبَّكُمْ إِلَيَّ وَأَقْرَبَكُمْ مِنِّي مَجْلِسًا يَوْمَ الْقِيَامَةِ أَحَاسِنَكُمْ أَخْلَاقًا",
          bn: "কিয়ামতের দিন তোমাদের মধ্যে আমার সবচেয়ে প্রিয় ও আমার সবচেয়ে নিকটে আসন পাবে তারা, যাদের আখলাক (চরিত্র ও আচরণ) সবচেয়ে উত্তম।",
          narrator: "জাবির ইবনে আবদুল্লাহ (রা.)", src: "সুনানে তিরমিজি: ২০১৮", kw: "আখলাক চরিত্র কিয়ামত" },
        { ar: "سَبْعَةٌ يُظِلُّهُمُ اللَّهُ فِي ظِلِّهِ، يَوْمَ لَا ظِلَّ إِلَّا ظِلُّهُ",
          bn: "সাত শ্রেণির মানুষকে আল্লাহ তাঁর (আরশের) ছায়ায় আশ্রয় দেবেন, যেদিন তাঁর ছায়া ছাড়া আর কোনো ছায়া থাকবে না — তাদের মধ্যে রয়েছেন ন্যায়পরায়ণ শাসক, আল্লাহর ইবাদতে বেড়ে ওঠা যুবক এবং গোপনে সদকাকারী ব্যক্তি।",
          narrator: "আবু হুরায়রা (রা.)", src: "সহিহ বুখারি: ৬৬০, সহিহ মুসলিম: ১০৩১", kw: "ছায়া কিয়ামত আরশ যুবক" },
        { ar: "أَفْضَلُ الذِّكْرِ لَا إِلَٰهَ إِلَّا اللَّهُ، وَأَفْضَلُ الدُّعَاءِ الْحَمْدُ لِلَّهِ",
          bn: "সর্বোত্তম যিকির হলো ‘লা ইলাহা ইল্লাল্লাহ’ এবং সর্বোত্তম দোয়া হলো ‘আলহামদুলিল্লাহ’।",
          narrator: "জাবির ইবনে আবদুল্লাহ (রা.)", src: "সুনানে তিরমিজি: ৩৩৮৩, ইবনে মাজাহ: ৩৮০০", kw: "যিকির দোয়া আলহামদুলিল্লাহ" },
        { ar: "إِنَّمَا يَرْحَمُ اللَّهُ مِنْ عِبَادِهِ الرُّحَمَاءَ",
          bn: "নিশ্চয় আল্লাহ তাঁর বান্দাদের মধ্যে কেবল দয়ালুদের প্রতিই দয়া করেন।",
          narrator: "উসামা ইবনে যায়দ (রা.)", src: "সহিহ বুখারি: ১২৮৪, সহিহ মুসলিম: ৯২৩", kw: "দয়া রহমত দয়ালু" }
      ];

      var DUAS = [
        { title: "ঘুমানোর দোয়া", cat: "ঘুম",
          ar: "اللَّهُمَّ بِاسْمِكَ أَمُوتُ وَأَحْيَا",
          uccharon: "আল্লাহুম্মা বিসমিকা আমূতু ওয়া আহইয়া",
          ortho: "হে আল্লাহ! আপনার নামেই আমি মৃত্যুবরণ করি (ঘুমাই) এবং আপনার নামেই জীবিত হই (জেগে উঠি)।",
          src: "সহিহ বুখারি: ৬৩২৪" },
        { title: "ঘুম থেকে জাগার দোয়া", cat: "সকাল-সন্ধ্যা",
          ar: "الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ",
          uccharon: "আলহামদু লিল্লাহিল্লাযী আহইয়ানা বা‘দা মা আমাতানা ওয়া ইলাইহিন নুশূর",
          ortho: "সকল প্রশংসা আল্লাহর, যিনি আমাদের মৃত্যু (ঘুম) এর পর জীবিত করলেন, আর তাঁর কাছেই আমাদের ফিরে যেতে হবে।",
          src: "সহিহ বুখারি: ৬৩১২" },
        { title: "সাইয়িদুল ইস্তিগফার", cat: "সকাল-সন্ধ্যা",
          ar: "اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَٰهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَىٰ عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ بِذَنْبِي فَاغْفِرْ لِي، فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ",
          uccharon: "আল্লাহুম্মা আনতা রাব্বী লা ইলাহা ইল্লা আনতা, খালাকতানী ওয়া আনা আবদুকা, ওয়া আনা আলা আহদিকা ওয়া ওয়া‘দিকা মাসতাত্ব‘তু, আউযু বিকা মিন শাররি মা সানা‘তু, আবূউ লাকা বিনি‘মাতিকা আলাইয়্যা, ওয়া আবূউ বিযাম্বী ফাগফির লী, ফাইন্নাহু লা ইয়াগফিরুয যুনূবা ইল্লা আনতা",
          ortho: "হে আল্লাহ! আপনিই আমার প্রতিপালক, আপনি ছাড়া কোনো ইলাহ নেই। আপনি আমাকে সৃষ্টি করেছেন, আমি আপনার বান্দা। আমি সাধ্যমতো আপনার অঙ্গীকার ও প্রতিশ্রুতির উপর অটল আছি। আমার কৃতকর্মের অনিষ্ট থেকে আপনার আশ্রয় চাই। আমার প্রতি আপনার অনুগ্রহ স্বীকার করছি এবং আমার গুনাহও স্বীকার করছি — আমাকে ক্ষমা করুন, কারণ আপনি ছাড়া কেউ গুনাহ ক্ষমা করতে পারে না।",
          src: "সহিহ বুখারি: ৬৩০৬",
          fazilat: "যে ব্যক্তি সকালে দৃঢ় বিশ্বাসের সাথে এটি পড়বে এবং সন্ধ্যার আগে মারা যাবে, সে জান্নাতে প্রবেশ করবে। (বুখারি: ৬৩০৬)" },
