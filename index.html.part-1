          ar: "السَّلَامُ عَلَيْكُمْ أَهْلَ الدِّيَارِ مِنَ الْمُؤْمِنِينَ وَالْمُسْلِمِينَ، وَإِنَّا إِنْ شَاءَ اللَّهُ بِكُمْ لَلَاحِقُونَ، أَسْأَلُ اللَّهَ لَنَا وَلَكُمُ الْعَافِيَةَ",
          uccharon: "আসসালামু আলাইকুম আহলাদ দিয়ারি মিনাল মু’মিনীনা ওয়াল মুসলিমীন, ওয়া ইন্না ইনশাআল্লাহু বিকুম লালাহিকূন, আসআলুল্লাহা লানা ওয়া লাকুমুল আফিয়াহ",
          ortho: "তোমাদের উপর শান্তি বর্ষিত হোক, হে কবরবাসী মুমিন ও মুসলিমগণ! ইনশাআল্লাহ আমরাও তোমাদের সাথে মিলিত হব। আমি আল্লাহর কাছে আমাদের ও তোমাদের জন্য নিরাপত্তা ও সুস্থতা প্রার্থনা করছি।",
          src: "সহিহ মুসলিম: ৯৭৪" },
        { title: "মৃত মুমিনদের জন্য দোয়া", cat: "পরিবার",
          ar: "رَبَّنَا اغْفِرْ لَنَا وَلِإِخْوَانِنَا الَّذِينَ سَبَقُونَا بِالْإِيمَانِ",
          uccharon: "রাব্বানাগ ফির লানা ওয়া লিইখওয়ানিনাল্লাযীনা সাবাকূনা বিল ঈমান",
          ortho: "হে আমাদের প্রতিপালক! আমাদের ক্ষমা করুন এবং আমাদের সেই ভাইদেরও, যারা ঈমান নিয়ে আমাদের আগে চলে গেছেন।",
          src: "সূরা আল-হাশর: ১০" }
      ];

      var AYAT = [
        { surah: "সূরা আল-বাকারা", ref: "সূরা আল-বাকারা: ২৫৫", cat: "তাওহিদ",
          ar: "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ ۚ لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا بِإِذْنِهِ ۚ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۖ وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ ۚ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ ۖ وَلَا يَئُودُهُ حِفْظُهُمَا ۚ وَهُوَ الْعَلِيُّ الْعَظِيمُ",
          bn: "আল্লাহ — তিনি ছাড়া কোনো ইলাহ নেই, তিনি চিরজীবী, সবকিছুর ধারক। তাঁকে তন্দ্রাও স্পর্শ করে না, ঘুমও না। আসমান ও জমিনে যা কিছু আছে সবই তাঁর। তাঁর অনুমতি ছাড়া তাঁর কাছে সুপারিশ করবে, এমন কে আছে? তিনি জানেন তাদের সামনে ও পেছনে যা কিছু আছে। তিনি যা ইচ্ছা করেন তা ছাড়া তাঁর জ্ঞানের কিছুই তারা আয়ত্ত করতে পারে না। তাঁর কুরসি আসমান ও জমিন জুড়ে পরিব্যাপ্ত, আর এ দুটোর রক্ষণাবেক্ষণ তাঁকে ক্লান্ত করে না। তিনি সর্বোচ্চ, সর্বমহান।",
          note: "এটি আয়াতুল কুরসি — কুরআনের সর্বশ্রেষ্ঠ আয়াত। প্রতি ফরজ নামাজের পর ও ঘুমানোর আগে পড়ার ফজিলত হাদিসে এসেছে। (মুসলিম: ৮১০, বুখারি: ২৩১১)",
          kw: "আয়াতুল কুরসি আল্লাহ তাওহিদ সুরক্ষা" },
        { surah: "সূরা আশ-শারহ", ref: "সূরা আশ-শারহ (আল-ইনশিরাহ): ৫–৬", cat: "আশা",
          ar: "فَإِنَّ مَعَ الْعُسْرِ يُسْرًا ۝ إِنَّ مَعَ الْعُسْرِ يُسْرًا",
          bn: "নিশ্চয় কষ্টের সাথেই রয়েছে স্বস্তি। নিশ্চয়ই কষ্টের সাথেই রয়েছে স্বস্তি।",
          kw: "কষ্ট স্বস্তি আশা ধৈর্য" },
        { surah: "সূরা আর-রা‘দ", ref: "সূরা আর-রা‘দ: ২৮", cat: "শান্তি",
          ar: "الَّذِينَ آمَنُوا وَتَطْمَئِنُّ قُلُوبُهُم بِذِكْرِ اللَّهِ ۗ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ",
          bn: "যারা ঈমান এনেছে এবং আল্লাহর যিকিরে যাদের অন্তর প্রশান্ত হয়। জেনে রাখো, আল্লাহর যিকিরেই অন্তরসমূহ প্রশান্ত হয়।",
          kw: "যিকির শান্তি অন্তর প্রশান্তি" },
        { surah: "সূরা আল-বাকারা", ref: "সূরা আল-বাকারা: ১৫৩", cat: "ধৈর্য",
          ar: "يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
          bn: "হে মুমিনগণ! তোমরা ধৈর্য ও নামাজের মাধ্যমে সাহায্য প্রার্থনা করো। নিশ্চয় আল্লাহ ধৈর্যশীলদের সাথে আছেন।",
          kw: "ধৈর্য নামাজ সাহায্য সবর" },
        { surah: "সূরা আত-তালাক", ref: "সূরা আত-তালাক: ২–৩", cat: "রিজিক",
          ar: "وَمَن يَتَّقِ اللَّهَ يَجْعَل لَّهُ مَخْرَجًا ۝ وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ ۚ وَمَن يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ",
          bn: "যে আল্লাহকে ভয় করে (তাকওয়া অবলম্বন করে), আল্লাহ তার জন্য (সংকট থেকে) বের হওয়ার পথ করে দেন এবং তাকে এমন জায়গা থেকে রিজিক দেন, যা সে ধারণাও করতে পারে না। আর যে আল্লাহর উপর ভরসা করে, আল্লাহই তার জন্য যথেষ্ট।",
          kw: "তাকওয়া রিজিক ভরসা তাওয়াক্কুল মুক্তি" },
        { surah: "সূরা আয-যুমার", ref: "সূরা আয-যুমার: ৫৩", cat: "রহমত",
          ar: "قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَىٰ أَنفُسِهِمْ لَا تَقْنَطُوا مِن رَّحْمَةِ اللَّهِ ۚ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا ۚ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ",
          bn: "বলুন: হে আমার বান্দারা, যারা নিজেদের উপর সীমালঙ্ঘন করেছ! তোমরা আল্লাহর রহমত থেকে নিরাশ হয়ো না। নিশ্চয় আল্লাহ সকল গুনাহ ক্ষমা করেন। নিশ্চয় তিনি অতি ক্ষমাশীল, পরম দয়ালু।",
          kw: "রহমত ক্ষমা তাওবা নিরাশ গুনাহ" },
        { surah: "সূরা আল-বাকারা", ref: "সূরা আল-বাকারা: ১৫২", cat: "যিকির",
          ar: "فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ",
          bn: "সুতরাং তোমরা আমাকে স্মরণ করো, আমিও তোমাদের স্মরণ করব। আর আমার প্রতি কৃতজ্ঞ হও এবং অকৃতজ্ঞ হয়ো না।",
          kw: "যিকির স্মরণ কৃতজ্ঞতা শুকরিয়া" },
        { surah: "সূরা গাফির", ref: "সূরা গাফির (আল-মু’মিন): ৬০", cat: "দোয়া",
          ar: "وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ",
          bn: "তোমাদের প্রতিপালক বলেছেন: তোমরা আমাকে ডাকো (আমার কাছে দোয়া করো), আমি তোমাদের ডাকে সাড়া দেব।",
          kw: "দোয়া ডাক সাড়া কবুল" },
        { surah: "সূরা আল-বাকারা", ref: "সূরা আল-বাকারা: ২৮৬", cat: "ধৈর্য",
          ar: "لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا",
          bn: "আল্লাহ কোনো ব্যক্তির উপর তার সাধ্যের বাইরে কোনো দায়িত্ব (বোঝা) চাপিয়ে দেন না।",
          kw: "সাধ্য বোঝা পরীক্ষা ধৈর্য" },
        { surah: "সূরা আল-আনকাবুত", ref: "সূরা আল-আনকাবুত: ৪৫", cat: "নামাজ",
          ar: "إِنَّ الصَّلَاةَ تَنْهَىٰ عَنِ الْفَحْشَاءِ وَالْمُنكَرِ ۗ وَلَذِكْرُ اللَّهِ أَكْبَرُ",
          bn: "নিশ্চয় নামাজ অশ্লীলতা ও মন্দ কাজ থেকে বিরত রাখে। আর আল্লাহর স্মরণই সর্বশ্রেষ্ঠ।",
          kw: "নামাজ অশ্লীলতা মন্দ যিকির" },
        { surah: "সূরা আল-বাকারা", ref: "সূরা আল-বাকারা: ২২২", cat: "তাওবা",
          ar: "إِنَّ اللَّهَ يُحِبُّ التَّوَّابِينَ وَيُحِبُّ الْمُتَطَهِّرِينَ",
          bn: "নিশ্চয় আল্লাহ তাওবাকারীদের ভালোবাসেন এবং যারা পবিত্র থাকে তাদেরও ভালোবাসেন।",
          kw: "তাওবা পবিত্রতা ভালোবাসা" },
        { surah: "সূরা আল-ইসরা", ref: "সূরা আল-ইসরা: ২৩", cat: "পিতামাতা",
          ar: "وَقَضَىٰ رَبُّكَ أَلَّا تَعْبُدُوا إِلَّا إِيَّاهُ وَبِالْوَالِدَيْنِ إِحْسَانًا",
          bn: "তোমার প্রতিপালক নির্দেশ দিয়েছেন: তোমরা তিনি ছাড়া অন্য কারো ইবাদত করবে না এবং পিতামাতার সাথে সদ্ব্যবহার করবে।",
          kw: "পিতামাতা সদ্ব্যবহার ইবাদত" },
        { surah: "সূরা আল-হুজুরাত", ref: "সূরা আল-হুজুরাত: ১৩", cat: "তাকওয়া",
          ar: "إِنَّ أَكْرَمَكُمْ عِندَ اللَّهِ أَتْقَاكُمْ ۚ إِنَّ اللَّهَ عَلِيمٌ خَبِيرٌ",
          bn: "নিশ্চয় আল্লাহর কাছে তোমাদের মধ্যে সবচেয়ে সম্মানিত সে-ই, যে তোমাদের মধ্যে সবচেয়ে বেশি তাকওয়াবান। নিশ্চয় আল্লাহ সর্বজ্ঞ, সবকিছুর খবর রাখেন।",
          kw: "তাকওয়া সম্মান মর্যাদা" },
        { surah: "সূরা আল-মায়িদা", ref: "সূরা আল-মায়িদা: ২", cat: "সৎকাজ",
          ar: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ ۖ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ",
          bn: "তোমরা সৎকাজ ও তাকওয়ার ব্যাপারে পরস্পরকে সহযোগিতা করো, আর পাপ ও সীমালঙ্ঘনের ব্যাপারে পরস্পরকে সহযোগিতা করো না।",
          kw: "সহযোগিতা সৎকাজ তাকওয়া পাপ" },
        { surah: "সূরা আত-তাওবা", ref: "সূরা আত-তাওবা: ১১৯", cat: "সত্য",
          ar: "يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَكُونُوا مَعَ الصَّادِقِينَ",
          bn: "হে মুমিনগণ! তোমরা আল্লাহকে ভয় করো এবং সত্যবাদীদের সাথে থাকো।",
          kw: "সত্য সত্যবাদী তাকওয়া সঙ্গ" },
        { surah: "সূরা আল-আহযাব", ref: "সূরা আল-আহযাব: ২১", cat: "আদর্শ",
          ar: "لَّقَدْ كَانَ لَكُمْ فِي رَسُولِ اللَّهِ أُسْوَةٌ حَسَنَةٌ",
          bn: "নিশ্চয় তোমাদের জন্য আল্লাহর রাসুলের মধ্যে রয়েছে উত্তম আদর্শ।",
          kw: "রাসুল আদর্শ অনুসরণ সুন্নাহ" },
        { surah: "সূরা আল-আম্বিয়া", ref: "সূরা আল-আম্বিয়া: ১০৭", cat: "রহমত",
          ar: "وَمَا أَرْسَلْنَاكَ إِلَّا رَحْمَةً لِّلْعَالَمِينَ",
          bn: "আমি আপনাকে (হে মুহাম্মদ ﷺ) সমগ্র জগতের জন্য রহমতস্বরূপই পাঠিয়েছি।",
          kw: "রাসুল রহমত জগত" },
        { surah: "সূরা ক্বাফ", ref: "সূরা ক্বাফ: ১৬", cat: "নৈকট্য",
          ar: "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ الْوَرِيدِ",
          bn: "আমিই মানুষকে সৃষ্টি করেছি এবং তার মন তাকে যে কুমন্ত্রণা দেয় তাও আমি জানি; আর আমি তার গলার শিরা (শাহরগ) থেকেও তার বেশি নিকটে আছি।",
          kw: "আল্লাহ নিকট নৈকট্য মন" },
        { surah: "সূরা আল-ইখলাস", ref: "সূরা আল-ইখলাস: ১–৪", cat: "তাওহিদ",
          ar: "قُلْ هُوَ اللَّهُ أَحَدٌ ۝ اللَّهُ الصَّمَدُ ۝ لَمْ يَلِدْ وَلَمْ يُولَدْ ۝ وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ",
          bn: "বলুন: তিনিই আল্লাহ, এক ও অদ্বিতীয়। আল্লাহ কারো মুখাপেক্ষী নন, সবাই তাঁর মুখাপেক্ষী। তিনি কাউকে জন্ম দেননি এবং তাঁকেও জন্ম দেওয়া হয়নি। আর তাঁর সমকক্ষ কেউই নেই।",
          note: "সূরা আল-ইখলাস কুরআনের এক-তৃতীয়াংশের সমান সওয়াবের সূরা। (বুখারি: ৫০১৩, মুসলিম: ৮১১)",
          kw: "ইখলাস তাওহিদ আল্লাহ একত্ব" },
        { surah: "সূরা আলে ইমরান", ref: "সূরা আলে ইমরান: ১৬০", cat: "ভরসা",
          ar: "إِن يَنصُرْكُمُ اللَّهُ فَلَا غَالِبَ لَكُمْ ۖ وَإِن يَخْذُلْكُمْ فَمَن ذَا الَّذِي يَنصُرُكُم مِّن بَعْدِهِ ۗ وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ",
          bn: "যদি আল্লাহ তোমাদের সাহায্য করেন, তবে কেউ তোমাদের উপর জয়ী হতে পারবে না। আর তিনি যদি তোমাদের সাহায্য না করেন, তবে তিনি ছাড়া কে আছে যে তোমাদের সাহায্য করবে? মুমিনদের উচিত কেবল আল্লাহর উপরই ভরসা করা।",
          kw: "সাহায্য ভরসা তাওয়াক্কুল বিজয়" }
      ];

      var ZIKRS = [
        { ar: "سُبْحَانَ اللَّهِ", bn: "সুবহানাল্লাহ" },
        { ar: "الْحَمْدُ لِلَّهِ", bn: "আলহামদুলিল্লাহ" },
        { ar: "اللَّهُ أَكْبَرُ", bn: "আল্লাহু আকবার" },
        { ar: "لَا إِلَٰهَ إِلَّا اللَّهُ", bn: "লা ইলাহা ইল্লাল্লাহ" },
        { ar: "أَسْتَغْفِرُ اللَّهَ", bn: "আসতাগফিরুল্লাহ" },
        { ar: "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ", bn: "সুবহানাল্লাহি ওয়া বিহামদিহি" },
        { ar: "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ", bn: "দরুদ — আল্লাহুম্মা সাল্লি আলা মুহাম্মাদ" },
        { ar: "لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ", bn: "লা হাওলা ওয়ালা কুওওয়াতা ইল্লা বিল্লাহ" }
      ];

      /* ================= সাহায্যকারী ফাংশন ================= */
      function $(id) { return document.getElementById(id); }
      function bnNum(n) {
        return String(n).replace(/[0-9]/g, function (d) { return "০১২৩৪৫৬৭৮৯"[Number(d)]; });
      }
      var toastTimer = null;
      function toast(msg) {
        var t = $("toast");
        t.textContent = msg;
        t.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { t.classList.remove("show"); }, 2400);
      }
      function copyText(text, okMsg) {
        function done() { toast(okMsg || "কপি হয়েছে — এখন যেকোনো জায়গায় পেস্ট করুন"); }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, function () { fallback(); });
        } else { fallback(); }
        function fallback() {
          var ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed"; ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand("copy"); done(); }
          catch (e) { toast("কপি করা যায়নি — লেখাটি হাতে সিলেক্ট করে কপি করুন"); }
          document.body.removeChild(ta);
        }
      }
      function dayOfYear(d) {
        var start = new Date(d.getFullYear(), 0, 0);
        return Math.floor((d - start) / 86400000);
      }

      /* ================= তারিখ ================= */
      (function showDate() {
        var now = new Date();
        try {
          $("todayBn").textContent = new Intl.DateTimeFormat("bn-BD", { weekday: "long", day: "numeric", month: "long", year: "numeric" }).format(now);
          $("todayEn").textContent = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(now);
        } catch (e) {
          $("todayBn").textContent = bnNum(now.getDate()) + "/" + bnNum(now.getMonth() + 1) + "/" + bnNum(now.getFullYear());
        }
      })();

      /* ================= আজকের হাদিস ও দোয়া ================= */
      var baseDay = dayOfYear(new Date());
      var hadithOffset = 0, duaOffset = 0;

      function dayName(off) {
        if (off === 0) return "আজ";
        if (off === -1) return "গতকাল";
        if (off === 1) return "আগামীকাল";
        return off < 0 ? bnNum(-off) + " দিন আগে" : bnNum(off) + " দিন পরে";
      }
      function pickIdx(len, off) {
        return ((baseDay + off) % len + len) % len;
      }
      function renderDailyHadith() {
        var h = HADITH[pickIdx(HADITH.length, hadithOffset)];
        $("dailyHadithAr").textContent = h.ar;
        $("dailyHadithBn").textContent = h.bn;
        $("dailyHadithNarrator").textContent = h.narrator;
        $("dailyHadithSrc").textContent = h.src;
        $("hadithDayName").textContent = dayName(hadithOffset);
        $("copyHadith").onclick = function () {
          copyText("আজকের হাদিস\n\n" + h.ar + "\n\nঅর্থ: " + h.bn + "\n\nবর্ণনাকারী: " + h.narrator + "\nসূত্র: " + h.src, "হাদিসটি কপি হয়েছে");
        };
        $("cardHadith").onclick = function () {
          makeCard("আজকের হাদিস", h.ar, h.bn, "বর্ণনাকারী: " + h.narrator + " । সূত্র: " + h.src, "hadith-card.png");
        };
      }
      function renderDailyDua() {
        var d = DUAS[pickIdx(DUAS.length, duaOffset + 5)];
        $("dailyDuaAr").textContent = d.ar;
        $("dailyDuaUccharon").textContent = d.uccharon;
        $("dailyDuaOrtho").textContent = d.ortho;
        $("dailyDuaSrc").textContent = d.src;
        $("duaDayName").textContent = dayName(duaOffset);
        $("dailyDuaFazilat").innerHTML = d.fazilat ? '<div class="fazilat"><b>ফজিলত:</b> ' + escapeHtml(d.fazilat) + "</div>" : "";
        $("copyDua").onclick = function () {
          var txt = d.title + "\n\n" + d.ar + "\n\nউচ্চারণ: " + d.uccharon + "\n\nঅর্থ: " + d.ortho + "\n\nসূত্র: " + d.src;
          if (d.fazilat) txt += "\nফজিলত: " + d.fazilat;
          copyText(txt, "দোয়াটি কপি হয়েছে");
        };
        $("cardDua").onclick = function () {
          makeCard(d.title, d.ar, d.ortho, "সূত্র: " + d.src, "dua-card.png");
        };
      }
      function escapeHtml(s) {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }
      $("hadithPrev").onclick = function () { hadithOffset--; renderDailyHadith(); };
      $("hadithNext").onclick = function () { hadithOffset++; renderDailyHadith(); };
      $("duaPrev").onclick = function () { duaOffset--; renderDailyDua(); };
      $("duaNext").onclick = function () { duaOffset++; renderDailyDua(); };
      renderDailyHadith();
      renderDailyDua();

      /* ================= আজকের আয়াত ================= */
      var ayatOffset = 0;
      function renderDailyAyat() {
        var a = AYAT[pickIdx(AYAT.length, ayatOffset + 2)];
        $("dailyAyatAr").textContent = a.ar;
        $("dailyAyatBn").textContent = a.bn;
        $("dailyAyatSurah").textContent = a.surah;
        $("dailyAyatSrc").textContent = a.ref;
        $("ayatDayName").textContent = dayName(ayatOffset);
        $("dailyAyatNote").innerHTML = a.note ? '<div class="fazilat"><b>ব্যাখ্যা:</b> ' + escapeHtml(a.note) + "</div>" : "";
        $("copyAyat").onclick = function () {
          var txt = "আজকের আয়াত — " + a.surah + "\n\n" + a.ar + "\n\nঅর্থ: " + a.bn + "\n\nসূত্র: " + a.ref;
          if (a.note) txt += "\n" + a.note;
          copyText(txt, "আয়াতটি কপি হয়েছে");
        };
        $("cardAyat").onclick = function () {
          makeCard("আজকের আয়াত — " + a.surah, a.ar, a.bn, "সূত্র: " + a.ref, "ayat-card.png");
        };
      }
      $("ayatPrev").onclick = function () { ayatOffset--; renderDailyAyat(); };
      $("ayatNext").onclick = function () { ayatOffset++; renderDailyAyat(); };
      renderDailyAyat();

      /* ================= ভান্ডারের হিসাব ================= */
      (function showStats() {
        $("statAyat").textContent = bnNum(AYAT.length) + "টি";
        $("statHadith").textContent = bnNum(HADITH.length) + "টি";
        $("statDua").textContent = bnNum(DUAS.length) + "টি";
        $("statZikr").textContent = bnNum(ZIKRS.length) + "টি";
        $("ayatCountText").textContent = "মোট " + bnNum(AYAT.length) + "টি বাছাই করা আয়াত";
        $("duaCountText").textContent = "মোট " + bnNum(DUAS.length) + "টি মাসনুন দোয়া";
        $("hadithCountText").textContent = "মোট " + bnNum(HADITH.length) + "টি বাছাই করা হাদিস";
      })();

      /* ================= ছবি কার্ড তৈরি ================= */
      function wrapText(ctx, text, maxWidth) {
        var words = text.split(/\s+/), lines = [], line = "";
        for (var i = 0; i < words.length; i++) {
          var test = line ? line + " " + words[i] : words[i];
          if (ctx.measureText(test).width > maxWidth && line) { lines.push(line); line = words[i]; }
          else line = test;
        }
        if (line) lines.push(line);
        return lines;
      }
      function makeCard(label, ar, bn, srcLine, filename) {
        function draw() {
          var c = $("cardCanvas"), ctx = c.getContext("2d");
          var W = 1200, H = 1200;
          var grad = ctx.createLinearGradient(0, 0, W, H);
          grad.addColorStop(0, "#0d5c40"); grad.addColorStop(1, "#07382a");
          ctx.fillStyle = grad; ctx.fillRect(0, 0, W, H);
          // decorative stars
          ctx.strokeStyle = "rgba(233,212,136,0.13)"; ctx.lineWidth = 2;
          for (var gx = 60; gx < W; gx += 120) {
            for (var gy = 60; gy < H; gy += 120) {
              ctx.beginPath();
              ctx.moveTo(gx, gy - 26); ctx.lineTo(gx + 10, gy - 10); ctx.lineTo(gx + 26, gy); ctx.lineTo(gx + 10, gy + 10);
              ctx.lineTo(gx, gy + 26); ctx.lineTo(gx - 10, gy + 10); ctx.lineTo(gx - 26, gy); ctx.lineTo(gx - 10, gy - 10);
              ctx.closePath(); ctx.stroke();
            }
          }
          // frame
          ctx.strokeStyle = "#c9a227"; ctx.lineWidth = 6; ctx.strokeRect(36, 36, W - 72, H - 72);
          ctx.strokeStyle = "rgba(236,214,138,0.55)"; ctx.lineWidth = 2; ctx.strokeRect(56, 56, W - 112, H - 112);
          ctx.textAlign = "center";
          // label
          ctx.fillStyle = "#ecd68a";
          ctx.font = "700 44px 'Hind Siliguri', sans-serif";
          ctx.fillText(label, W / 2, 150);
          ctx.fillStyle = "#c9a227";
          ctx.fillRect(W / 2 - 90, 180, 180, 4);
          // arabic
          ctx.fillStyle = "#ffffff";
          ctx.font = "64px 'Amiri', serif";
          var arLines = wrapText(ctx, ar, W - 260);
          var y = 268;
          for (var i = 0; i < arLines.length; i++) { ctx.fillText(arLines[i], W / 2, y); y += 104; }
          // bengali meaning
          y += 26;
          ctx.fillStyle = "#eef5ef";
          ctx.font = "500 43px 'Hind Siliguri', sans-serif";
          var bnLines = wrapText(ctx, bn, W - 220);
          for (var j = 0; j < bnLines.length; j++) { ctx.fillText(bnLines[j], W / 2, y); y += 66; }
          // source
          ctx.fillStyle = "#cfe3d6";
          ctx.font = "34px 'Hind Siliguri', sans-serif";
          var srcLines = wrapText(ctx, srcLine, W - 240);
          var sy = H - 196;
          for (var k = 0; k < srcLines.length; k++) { ctx.fillText(srcLines[k], W / 2, sy); sy += 48; }
          // footer brand
          ctx.fillStyle = "#ecd68a";
          ctx.font = "700 40px 'Noto Serif Bengali', serif";
          ctx.fillText("প্রতিদিনের দোয়া ও হাদিস", W / 2, H - 92);
          // download
          var a = document.createElement("a");
          a.download = filename;
          a.href = c.toDataURL("image/png");
          document.body.appendChild(a); a.click(); document.body.removeChild(a);
          toast("ছবি কার্ড ডাউনলোড হচ্ছে");
        }
        if (document.fonts && document.fonts.ready) {
          Promise.all([
            document.fonts.load("64px 'Amiri'"),
            document.fonts.load("500 43px 'Hind Siliguri'"),
            document.fonts.load("700 40px 'Noto Serif Bengali'")
          ]).then(draw, draw);
        } else { draw(); }
      }

      /* ================= যিকির কাউন্টার ================= */
      var zikrIdx = 0, zikrCount = 0, zikrTarget = 33;
      var targets = [33, 100];
      function renderZikrTabs() {
        var wrap = $("zikrTabs");
        wrap.innerHTML = "";
        ZIKRS.forEach(function (z, i) {
          var b = document.createElement("button");
          b.type = "button";
          b.textContent = z.bn;
          if (i === zikrIdx) b.className = "active";
          b.onclick = function () { zikrIdx = i; zikrCount = 0; renderZikrTabs(); renderZikr(); };
          wrap.appendChild(b);
        });
      }
      function renderZikr() {
        var z = ZIKRS[zikrIdx];
        $("zikrAr").textContent = z.ar;
        $("zikrBn").textContent = z.bn;
        $("zikrCount").textContent = bnNum(zikrCount);
        $("zikrTarget").textContent = "লক্ষ্য: " + bnNum(zikrTarget) + " বার";
        $("zikrBar").style.width = Math.min(100, (zikrCount / zikrTarget) * 100) + "%";
        $("zikrDone").textContent = zikrCount >= zikrTarget ? "আলহামদুলিল্লাহ! লক্ষ্য পূর্ণ হয়েছে। আল্লাহ কবুল করুন।" : "";
        $("zikrTargetBtn").textContent = "লক্ষ্য: " + bnNum(zikrTarget) + " বার";
      }
      $("zikrTap").onclick = function () {
        zikrCount++;
        if (navigator.vibrate && zikrCount === zikrTarget) navigator.vibrate(120);
        renderZikr();
      };
      $("zikrReset").onclick = function () { zikrCount = 0; renderZikr(); };
      $("zikrTargetBtn").onclick = function () {
        zikrTarget = zikrTarget === targets[0] ? targets[1] : targets[0];
        renderZikr();
      };
      renderZikrTabs();
      renderZikr();

      /* ================= দোয়ার ভান্ডার ================= */
      var duaCats = ["সব"];
      DUAS.forEach(function (d) { if (duaCats.indexOf(d.cat) === -1) duaCats.push(d.cat); });
      var activeCat = "সব", duaQuery = "";

      function renderDuaChips() {
        var wrap = $("duaChips");
        wrap.innerHTML = "";
        duaCats.forEach(function (cat) {
          var b = document.createElement("button");
          b.type = "button";
          b.className = "chip" + (cat === activeCat ? " active" : "");
          b.textContent = cat;
          b.onclick = function () { activeCat = cat; renderDuaChips(); renderDuas(); };
          wrap.appendChild(b);
        });
      }
      function duaCard(d) {
        var el = document.createElement("article");
        el.className = "item-card";
        var html = '<span class="cat">' + escapeHtml(d.cat) + "</span>" +
          "<h3>" + escapeHtml(d.title) + "</h3>" +
          '<p class="ar" lang="ar">' + escapeHtml(d.ar) + "</p>" +
          '<span class="field-name" style="text-align:left">উচ্চারণ</span>' +
          '<p class="uccharon">' + escapeHtml(d.uccharon) + "</p>" +
          '<span class="field-name" style="text-align:left">অর্থ</span>' +
          '<p class="bn-text">' + escapeHtml(d.ortho) + "</p>";
        if (d.fazilat) html += '<div class="fazilat"><b>ফজিলত:</b> ' + escapeHtml(d.fazilat) + "</div>";
        html += '<p class="source">সূত্র: <b>' + escapeHtml(d.src) + "</b></p>";
        el.innerHTML = html;
        var actions = document.createElement("div");
        actions.className = "card-actions";
        var copyBtn = document.createElement("button");
        copyBtn.type = "button"; copyBtn.className = "btn"; copyBtn.textContent = "কপি করুন";
        copyBtn.onclick = function () {
          var txt = d.title + "\n\n" + d.ar + "\n\nউচ্চারণ: " + d.uccharon + "\n\nঅর্থ: " + d.ortho + "\n\nসূত্র: " + d.src;
          if (d.fazilat) txt += "\nফজিলত: " + d.fazilat;
          copyText(txt, "দোয়াটি কপি হয়েছে");
        };
        var cardBtn = document.createElement("button");
        cardBtn.type = "button"; cardBtn.className = "btn secondary"; cardBtn.textContent = "ছবি কার্ড";
        cardBtn.onclick = function () { makeCard(d.title, d.ar, d.ortho, "সূত্র: " + d.src, "dua-card.png"); };
        actions.appendChild(copyBtn); actions.appendChild(cardBtn);
        el.appendChild(actions);
        return el;
      }
      function renderDuas() {
        var grid = $("duaGrid");
        grid.innerHTML = "";
        var q = duaQuery.trim();
        var list = DUAS.filter(function (d) {
          if (activeCat !== "সব" && d.cat !== activeCat) return false;
          if (!q) return true;
          return (d.title + " " + d.ortho + " " + d.uccharon + " " + d.cat + " " + d.ar).indexOf(q) !== -1;
        });
        if (!list.length) {
          grid.innerHTML = '<p class="empty-msg">দুঃখিত, এই খোঁজে কোনো দোয়া পাওয়া যায়নি। অন্য শব্দ দিয়ে চেষ্টা করুন।</p>';
          return;
        }
        list.forEach(function (d) { grid.appendChild(duaCard(d)); });
      }
      $("duaSearch").addEventListener("input", function (e) { duaQuery = e.target.value; renderDuas(); });
      renderDuaChips();
      renderDuas();

      /* ================= হাদিসের ভান্ডার ================= */
      var hadithQuery = "";
      function hadithCard(h) {
        var el = document.createElement("article");
        el.className = "item-card";
        el.innerHTML =
          '<p class="ar" lang="ar" style="margin-top:2px">' + escapeHtml(h.ar) + "</p>" +
          '<span class="field-name" style="text-align:left">বাংলা অর্থ</span>' +
          '<p class="bn-text">' + escapeHtml(h.bn) + "</p>" +
          '<p class="source">বর্ণনাকারী: <b>' + escapeHtml(h.narrator) + "</b><br />সূত্র: <b>" + escapeHtml(h.src) + "</b></p>";
        var actions = document.createElement("div");
        actions.className = "card-actions";
        var copyBtn = document.createElement("button");
        copyBtn.type = "button"; copyBtn.className = "btn"; copyBtn.textContent = "কপি করুন";
        copyBtn.onclick = function () {
          copyText(h.ar + "\n\nঅর্থ: " + h.bn + "\n\nবর্ণনাকারী: " + h.narrator + "\nসূত্র: " + h.src, "হাদিসটি কপি হয়েছে");
        };
        var cardBtn = document.createElement("button");
        cardBtn.type = "button"; cardBtn.className = "btn secondary"; cardBtn.textContent = "ছবি কার্ড";
        cardBtn.onclick = function () { makeCard("হাদিস", h.ar, h.bn, "বর্ণনাকারী: " + h.narrator + " । সূত্র: " + h.src, "hadith-card.png"); };
        actions.appendChild(copyBtn); actions.appendChild(cardBtn);
        el.appendChild(actions);
        return el;
      }
      function renderHadiths() {
        var grid = $("hadithGrid");
        grid.innerHTML = "";
        var q = hadithQuery.trim();
        var list = HADITH.filter(function (h) {
          if (!q) return true;
          return (h.bn + " " + h.kw + " " + h.narrator + " " + h.ar).indexOf(q) !== -1;
        });
        if (!list.length) {
          grid.innerHTML = '<p class="empty-msg">দুঃখিত, এই খোঁজে কোনো হাদিস পাওয়া যায়নি। অন্য শব্দ দিয়ে চেষ্টা করুন।</p>';
          return;
        }
        list.forEach(function (h) { grid.appendChild(hadithCard(h)); });
      }
      $("hadithSearch").addEventListener("input", function (e) { hadithQuery = e.target.value; renderHadiths(); });
      renderHadiths();

      /* ================= কুরআনের আয়াতের ভান্ডার ================= */
      var ayatCats = ["সব"];
      AYAT.forEach(function (a) { if (ayatCats.indexOf(a.cat) === -1) ayatCats.push(a.cat); });
      var activeAyatCat = "সব", ayatQuery = "";
      function renderAyatChips() {
        var wrap = $("ayatChips");
        wrap.innerHTML = "";
        ayatCats.forEach(function (cat) {
          var b = document.createElement("button");
          b.type = "button";
          b.className = "chip" + (cat === activeAyatCat ? " active" : "");
          b.textContent = cat;
          b.onclick = function () { activeAyatCat = cat; renderAyatChips(); renderAyats(); };
          wrap.appendChild(b);
        });
      }
      function ayatCard(a) {
        var el = document.createElement("article");
        el.className = "item-card ayat-card";
        var html = '<span class="surah-badge">' + escapeHtml(a.surah) + "</span>" +
          '<span class="cat" style="margin-left:8px">' + escapeHtml(a.cat) + "</span>" +
          '<p class="ar" lang="ar">' + escapeHtml(a.ar) + "</p>" +
          '<span class="field-name" style="text-align:left">বাংলা অর্থ</span>' +
          '<p class="bn-text">' + escapeHtml(a.bn) + "</p>";
        if (a.note) html += '<div class="fazilat"><b>ব্যাখ্যা:</b> ' + escapeHtml(a.note) + "</div>";
        html += '<p class="source">সূত্র: <b>' + escapeHtml(a.ref) + "</b></p>";
        el.innerHTML = html;
        var actions = document.createElement("div");
        actions.className = "card-actions";
        var copyBtn = document.createElement("button");
        copyBtn.type = "button"; copyBtn.className = "btn"; copyBtn.textContent = "কপি করুন";
        copyBtn.onclick = function () {
          var txt = a.surah + "\n\n" + a.ar + "\n\nঅর্থ: " + a.bn + "\n\nসূত্র: " + a.ref;
          if (a.note) txt += "\n" + a.note;
          copyText(txt, "আয়াতটি কপি হয়েছে");
        };
        var cardBtn = document.createElement("button");
        cardBtn.type = "button"; cardBtn.className = "btn secondary"; cardBtn.textContent = "ছবি কার্ড";
        cardBtn.onclick = function () { makeCard(a.surah, a.ar, a.bn, "সূত্র: " + a.ref, "ayat-card.png"); };
        actions.appendChild(copyBtn); actions.appendChild(cardBtn);
        el.appendChild(actions);
        return el;
      }
      function renderAyats() {
        var grid = $("ayatGrid");
        grid.innerHTML = "";
        var q = ayatQuery.trim();
        var list = AYAT.filter(function (a) {
          if (activeAyatCat !== "সব" && a.cat !== activeAyatCat) return false;
          if (!q) return true;
          return (a.surah + " " + a.bn + " " + a.kw + " " + a.cat + " " + a.ar).indexOf(q) !== -1;
        });
        if (!list.length) {
          grid.innerHTML = '<p class="empty-msg">দুঃখিত, এই খোঁজে কোনো আয়াত পাওয়া যায়নি। অন্য শব্দ দিয়ে চেষ্টা করুন।</p>';
          return;
        }
        list.forEach(function (a) { grid.appendChild(ayatCard(a)); });
      }
      $("ayatSearch").addEventListener("input", function (e) { ayatQuery = e.target.value; renderAyats(); });
      renderAyatChips();
      renderAyats();

      /* ================= মোবাইলে ইনস্টল (PWA) ================= */
      var deferredInstallPrompt = null;
      function isStandalone() {
        return (window.matchMedia && window.matchMedia("(display-mode: standalone)").matches) || window.navigator.standalone === true;
      }
      /* পেজটি অন্য অ্যাপের (যেমন Muse) ভেতরের ফ্রেমে খোলা কিনা — ভেতরে খোলা থাকলে
         ব্রাউজারের Install অপশন আসে না এবং হোম স্ক্রিনে হোস্ট অ্যাপের শর্টকাট বসে */
      var inHostFrame = false;
      try { inHostFrame = window.self !== window.top; } catch (e) { inHostFrame = true; }
      var uaStr = navigator.userAgent || "";
      var isIOSDevice = /iphone|ipad|ipod/i.test(uaStr);
      if (isStandalone()) document.body.classList.add("is-installed");
      if (inHostFrame && !isStandalone()) {
        document.body.classList.add("in-host-app");
        $("installBtn").textContent = "Chrome-এ ইনস্টলের ধাপ দেখুন";
      }
      window.addEventListener("beforeinstallprompt", function (e) {
        e.preventDefault();
        deferredInstallPrompt = e;
        document.body.classList.add("can-install");
        if (!inHostFrame) $("installBtn").textContent = "এখনই ইনস্টল করুন";
      });
      window.addEventListener("appinstalled", function () {
        deferredInstallPrompt = null;
        document.body.classList.remove("can-install");
        document.body.classList.add("is-installed");
        toast("আলহামদুলিল্লাহ! অ্যাপটি ইনস্টল হয়ে গেছে");
      });
      $("installBtn").onclick = function () {
        if (isStandalone()) { toast("অ্যাপটি ইতিমধ্যে ইনস্টল করা আছে"); return; }
        if (deferredInstallPrompt) {
          var showInstallUi = deferredInstallPrompt.prompt.bind(deferredInstallPrompt);
          showInstallUi();
          deferredInstallPrompt.userChoice.then(function (choice) {
            if (choice && choice.outcome === "accepted") {
              document.body.classList.add("is-installed");
              toast("আলহামদুলিল্লাহ! অ্যাপটি ইনস্টল হয়ে গেছে");
            } else {
              toast("ইনস্টল বাতিল হয়েছে — নিচের ধাপগুলো দেখে আবার চেষ্টা করুন");
            }
            deferredInstallPrompt = null;
            document.body.classList.remove("can-install");
          });
          return;
        }
        var el = $("install");
        if (el && el.scrollIntoView) el.scrollIntoView({ behavior: "smooth", block: "start" });
        if (inHostFrame) {
          toast("এটি Muse অ্যাপের ভেতরের পেজ — আগে Chrome-এ খুলুন, ধাপগুলো উপরে দেওয়া আছে");
        } else if (isIOSDevice) {
          toast("আইফোনে: Safari-র Share বোতাম → “Add to Home Screen” চাপুন — নিচে ধাপে ধাপে দেওয়া আছে");
        } else {
          toast("Chrome-এর ⋮ মেনু থেকে “Install app” বেছে নিন — নিচে ধাপে ধাপে দেওয়া আছে");
        }
      };
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          /* প্রথমে পেজের মূল স্কোপে রেজিস্টার চেষ্টা — হোস্ট অনুমতি দিলে এতেই
             ইনস্টলের শর্ত পূরণ হয়; না হলে assets স্কোপে ফলব্যাক */
          navigator.serviceWorker.register("assets/sw.js", { scope: "./" })
            .catch(function () { return navigator.serviceWorker.register("assets/sw.js"); })
            .catch(function () { /* হোস্টে SW সাপোর্ট না থাকলে ইনস্টল নির্দেশনা দিয়েই চলবে */ });
        });
      }
    </script>
  </body>
</html>
